# Get your API key from https://resend.com/api-keys
RESEND_API_KEY=re_your_api_key_here

# ---------------------------------------------------------------------------
# Auth (owned: approved-access password + Google OAuth — no Clerk)
# ---------------------------------------------------------------------------

# Full public URL of this deployment, no trailing slash (used in auth emails)
APP_BASE_URL=https://getzybit.com

# "From" address for auth / welcome emails (must be a verified Resend sender).
# Recommended: a dedicated sending subdomain so transactional reputation is
# isolated from your root domain's corporate mail. Verify it in Resend first.
AUTH_FROM_EMAIL=Zybit <noreply@mail.getzybit.com>

# Where the "Request access" form notification lands (one address). Defaults to
# asad@getzybit.com if unset.
INTAKE_NOTIFY_EMAIL=asad@getzybit.com

# HMAC secret for one-time set-password tokens. Falls back to
# PUBLIC_AUDIT_SIGNING_SECRET if unset; required in production.
AUTH_SIGNING_SECRET=

# Google OAuth 2.0 (authorization-code flow). Create credentials at
# https://console.cloud.google.com/apis/credentials and set the redirect URL
# to <APP_BASE_URL>/api/auth/google/callback. Leave unset to disable the
# "Continue with Google" button (the email+password path still works).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URL=https://getzybit.com/api/auth/google/callback

# Password that protects /admin — pick something strong
ADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
DATABASE_URL=
NEXT_PUBLIC_DEFAULT_ORG_ID=org_default

# Phase 1 storage driver selection:
# - auto: prefer Postgres when DATABASE_URL exists, otherwise blob/local fallback
# - blob: force blob/local fallback path
# - postgres: force Postgres repository path
PHASE1_STORAGE_DRIVER=auto

# Phase 1 org identity mode:
# - dev: allow x-org-id header, query fallback, then default org id
# - header_required: require x-org-id header (recommended for production)
PHASE1_ORG_IDENTITY_MODE=dev

# Vercel Blob token for /discovery survey response storage
BLOB_READ_WRITE_TOKEN=

# ---------------------------------------------------------------------------
# Headless capture (Phase 2 — capture_v2)
# ---------------------------------------------------------------------------

BROWSERLESS_URL=wss://chrome.browserless.io
BROWSERLESS_KEY=

# Optional: extra origin allowed to iframe-embed annotated finding previews
# for synthetic Lighthouse sites. Local-dev only — leave unset in production
# so the preview CSP defaults to `frame-ancestors 'self'`.
# Must match `scheme://host[:port]` (e.g. http://localhost:3001).
LIGHTHOUSE_PREVIEW_ORIGIN=

# Feature flag override — set to "1" when Edge Config is unavailable
CAPTURE_V2_ENABLED=

# OpenAI API key — powers every AI call (AI Variant Advisor at
# `/api/dashboard/experiments/ai-suggest`, capture-time copy critique + visual
# signals, audit vision pass, fix-preview advisor + image inpaint + screenshot
# quality gate). All call sites route through `src/lib/ai/openai.ts`. Without
# this they degrade gracefully: ai-suggest returns 503, capture-time AI signals
# return null (rules fall back to structural-only), and the audit email omits
# the "What we saw" caption + AI fix preview.
OPENAI_API_KEY=
# Optional model overrides (defaults shown). Reasoning model drives the variant
# advisor + audit fix advisor; fast model drives capture-time extraction + the
# screenshot quality gate; image model drives Tier-2 fix-preview inpaint.
OPENAI_REASONING_MODEL=gpt-5.4
OPENAI_FAST_MODEL=gpt-5.4-mini
OPENAI_IMAGE_MODEL=gpt-image-1

# Cron auth secret — sent as "Authorization: Bearer <secret>" by Vercel cron
FORGE_CRON_SECRET=

# Used by the nightly refresh cron when a site's integration config lacks siteUrl
CAPTURE_SITE_URL_OVERRIDE=

# ---------------------------------------------------------------------------
# Observability
# ---------------------------------------------------------------------------
AXIOM_TOKEN=
AXIOM_DATASET=
CRONITOR_API_KEY=

# ---------------------------------------------------------------------------
# Edge Config (feature flags)
# ---------------------------------------------------------------------------
EDGE_CONFIG=

# ---------------------------------------------------------------------------
# Public URL audit (lead magnet — /audit)
# ---------------------------------------------------------------------------

# Test-email allowlist. Comma-separated personal-email addresses that are
# permitted past the work-email gate at /audit. All other gates (SSRF, rate
# limits, daily $25 budget, double-opt-in) still apply, so the abuse surface
# stays bounded by the inboxes you control.
#
# Two var names, pick based on whether the GUI needs to know:
# - PUBLIC_AUDIT_TEST_EMAILS:        server-only. Drive via curl / Postman.
# - NEXT_PUBLIC_AUDIT_TEST_EMAILS:   inlined into the client bundle so the
#                                    /audit form itself accepts the address.
#                                    Anything here is publicly visible — only
#                                    use addresses whose ownership is already
#                                    public (e.g. your own personal Gmail).
PUBLIC_AUDIT_TEST_EMAILS=
NEXT_PUBLIC_AUDIT_TEST_EMAILS=

# --- Public audit pipeline (required in production) ---
# Enables the before/after fix-preview pipeline. Set to '1' in Vercel to activate.
AUDIT_FIX_PREVIEW_ENABLED=

# HMAC secret for the audit confirmation cookie + signup link verification.
# Generate with: openssl rand -hex 32
PUBLIC_AUDIT_SIGNING_SECRET=

# From-address for confirmation + report emails (default: asad@getzybit.com)
AUDIT_FROM_EMAIL=

# Firecrawl key for website crawl during runUrlAudit (set in lighthouse/.env too)
FIRECRAWL_KEY=

# ---------------------------------------------------------------------------
# PostHog product analytics (Zybit's own usage tracking)
# Get your key from posthog.com → Project Settings → Project API Key
# ---------------------------------------------------------------------------
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
