# password gate reuses ADMIN_PASSWORD from zybit/.env
LIGHTHOUSE_PORT=3001

# only required when running --mode posthog
LIGHTHOUSE_POSTHOG_API_KEY=
LIGHTHOUSE_POSTHOG_HOST=https://us.i.posthog.com

# Zybit Next app origin — used by POST /lighthouse/api/impersonate/start to build
# the embed URL for the "Open as PM" iframe. Defaults to
# http://localhost:3000. Override if the Next dev server runs elsewhere.
# ZYBIT_APP_BASE_URL=http://localhost:3000
