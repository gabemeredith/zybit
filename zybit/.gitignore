# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — secrets and local overrides are never committed
.env*
# exception: example file is documentation, not secrets
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Local-only product narrative (full PRD); keep out of version control
PRD.full.md

# clerk configuration (can include secrets)
/.clerk/

# lighthouse — cloned upstream OSS sites used as Phase 1 fixtures.
# Manifests + patches under each site dir ARE tracked; the clones are not.
/lighthouse/sites/*/
!/lighthouse/sites/*/manifest.json
!/lighthouse/sites/*/patches/
!/lighthouse/sites/README.md
.env.local
